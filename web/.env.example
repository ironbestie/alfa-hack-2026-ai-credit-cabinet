# true: фронт работает на моках из mocks/, false: ходит в бэкенд через /api
NEXT_PUBLIC_USE_MOCKS=true

# Адрес бэкенда для проксирования /api/*
BACKEND_URL=http://localhost:8080

# Тестовые учётки из SecurityConfig, формат login:password
NEXT_PUBLIC_CLIENT_AUTH=client:password
NEXT_PUBLIC_MANAGER_AUTH=manager:password

# ИНН клиента по умолчанию для карточки предложения на главной
# 7707083893 автоодобрение, 7712345671 контрпредложение, 7710140679 отказ
# 7720000007 ликвидирована, 7730000006 ФНС не отвечает
NEXT_PUBLIC_DEMO_INN=
