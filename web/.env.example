# true: фронт работает на встроенных моках из mocks/, false: ходит в бэкенд через /api
NEXT_PUBLIC_USE_MOCKS=false

# Адрес бэкенда, на который Next проксирует /api/*
BACKEND_URL=http://localhost:8080

# Тестовые учётки из SecurityConfig, формат login:password
NEXT_PUBLIC_CLIENT_AUTH=client:password
NEXT_PUBLIC_MANAGER_AUTH=manager:password

# ИНН клиента по умолчанию для карточки лимита на главной (можно оставить пустым)
# 7704983159 одобрение, 7703168426 контрпредложение, 7729501760 отказ,
# 7722085341 ручная проверка, 7731497609 сбой ФНС, 7736150978 ликвидирована
NEXT_PUBLIC_DEMO_INN=
