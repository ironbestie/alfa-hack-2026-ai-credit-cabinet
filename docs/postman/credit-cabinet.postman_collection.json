                  "const product = pm.response.json().items.find(p => p.name === pm.collectionVariables.get(\"productName\"));",
                  "pm.test(\"Продукт найден\", () => pm.expect(product).to.be.an(\"object\"));",
                  "pm.collectionVariables.set(\"productId\", product.id);"
