            "description": "В Runner запрос повторяется каждые 2 секунды, пока идёт обработка (до 30 раз). Вручную просто отправьте его ещё раз."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const status = pm.response.json().status;",
                  "const attempt = Number(pm.collectionVariables.get(\"attempt\") || 0);",
                  "if ([\"SUBMITTED\", \"ENRICHMENT\", \"SCORING\", \"DECISION\"].includes(status) && attempt < 30) {",
                  "    pm.collectionVariables.set(\"attempt\", attempt + 1);",
                  "    setTimeout(() => {}, 2000);",
                  "    pm.execution.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "    pm.collectionVariables.set(\"attempt\", 0);",
                  "    pm.test(\"Решение: APPROVED\", () => pm.expect(status).to.eql(\"APPROVED\"));",
                  "}"
                ]
              }
            }
          ]
